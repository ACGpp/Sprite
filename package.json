{
  "name": "sprite",
  "version": "0.1.0",
  "description": "A quiet, local AI companion for macOS（v3：内核 + 原生外壳）",
  "author": "ACGpp",
  "private": true,
  "type": "module",
  "main": "core/main.ts",
  "scripts": {
    "core:test": "node --test \"core/**/*.test.ts\"",
    "core:typecheck": "tsc -p core/tsconfig.json",
    "spike:test": "node .spike/breath/test.mjs && node .spike/journal/test.mjs",
    "shell:build": "cd shell && CLANG_MODULE_CACHE_PATH=$PWD/.build/clang-cache SWIFT_MODULE_CACHE_PATH=$PWD/.build/swift-cache swift build --disable-sandbox --scratch-path .build --cache-path .build/cache",
    "shell:test": "cd shell && swift test --disable-sandbox --scratch-path .build --cache-path .build/cache",
    "verify:shell": "Scripts/verify-shell.sh",
    "verify:live": "Scripts/verify-live.sh",
    "verify:reconnect": "Scripts/verify-reconnect.sh",
    "verify:soak": "Scripts/verify-soak.sh",
    "measure:scale": "node Scripts/measure-scale.mjs",
    "verify:all": "Scripts/verify-all.sh",
    "demo": "Scripts/run-demo.sh",
    "app:build": "Scripts/build-app.sh release",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "core": "node core/main.ts",
    "shell": "cd shell && swift build --disable-sandbox --scratch-path .build --cache-path .build/cache",
    "policy:typecheck": "tsc -p pi-extension/tsconfig.json"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/node": "^20.14.15",
    "typescript": "^6.0.3"
  }
}
